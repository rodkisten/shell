{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shell",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-09",
  "r2_buckets": [{ "binding": "LINUX_ASSETS", "bucket_name": "shell-linux-assets" }],
  "previews": {
    "r2_buckets": [{ "binding": "LINUX_ASSETS", "bucket_name": "shell-linux-assets-preview" }]
  },
  "routes": [
    {
      "pattern": "shell.migos.club",
      "custom_domain": true,
      "previews_enabled": false,
      "enabled": true
    },
    {
      "pattern": "preview.shell.migos.club",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/v86/*",
      "/debian",
      "/debian/*",
      "/install/*"
    ]
  }
}
