{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shell",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-09",
  "r2_buckets": [{ "binding": "LINUX_ASSETS", "bucket_name": "shell-linux-assets" }],
  "previews": {
    // Preview deployments must never access the production Linux assets bucket.
    "r2_buckets": [{ "binding": "LINUX_ASSETS", "bucket_name": "shell-linux-assets-preview" }]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/v86/*"
    ]
  }
}
